# Copy to .env and fill in real values. Never commit the real .env file.
# Used by: compose.prod.yaml (docker compose -f compose.prod.yaml up -d)

# --- Caddy (HTTPS) ---
# Real DNS name pointing at this VM's public IP. Caddy requests/renews a
# Let's Encrypt certificate for it automatically — must be reachable on
# ports 80/443 from the internet for that to succeed.
DOMAIN=kaizan.yourdomain.com

# --- Telegram ---
BOT_TOKEN=
# Must match the secret_token configured on Telegram's setWebhook call.
TELEGRAM_WEBHOOK_SECRET=

# --- PostgreSQL ---
DB_NAME=kaizan-db9
DB_USER=
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# --- RunPod ---
# Submission URL for the deployed RunPod Serverless endpoint, e.g.:
# https://api.runpod.ai/v2/<ENDPOINT_ID>/run
# Must be /run (async), not /runsync: the real result never arrives on this
# call's response anyway (handler.py delivers it via its own callback to
# KAIZAN_CALLBACK_URL) — /runsync would just block a RabbitMQ listener
# thread waiting on a response we discard.
KATAGO_POST_URL_SYNC=
# RunPod API key (Bearer token), from the RunPod account settings.
RUNPOD_API_KEY=

RUNPOD_HEADER_SECRET=
# The endpoint id segment of your RunPod Serverless URL — e.g. for
# https://api.runpod.ai/v2/jozsdghx7372ud/run, that's "jozsdghx7372ud".
# Read by the status-api service (compose.prod.yaml), not by the app itself.
RUNPOD_ENDPOINT_ID=

# Used by the /resign Telegram command to actually cancel a job, via the
# status-api service compose.prod.yaml builds from ../runpod-handler. Keep
# this as the internal compose address — status-api has no host-published
# port, so nothing outside this VM can reach it directly.
RUNPOD_STATUS_URL=http://status-api:8971
# Optional — feeds RunPodHealthIndicator, whose check is currently a
# hardcoded stub (always reports UP regardless of this value).
RUNPOD_HEALTH_ENDPOINT=

# --- Google Drive ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_SECRET=

# --- Email ---
SENDER_MAIL_ADDRESS=
SENDER_MAIL_PASSWORD=

# --- Encryption ---
# 32-byte key for AES-256-GCM, in the format expected by the application.
ENCRYPTION_KEY=

# --- Mini App (CORS) ---
# Origin of the Vercel-hosted kaizen-miniapp allowed to call GET /kaizan/api/v1/katago/history.
MINIAPP_ORIGIN=https://your-miniapp.vercel.app
